  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "60479589-e821-4ff2-9cf6-c01cd0ab7c32"
      },
      "text": "live_sales\r\n| where event_time >= bin(ago(30m), 1m) and event_time < bin(now(), 1m)\r\n| summarize receipts = count() by bin(event_time, 1m)\r\n| order by event_time asc",
      "id": "348cb0a6-84be-42f6-9e38-e1dc4b1239d1",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "60479589-e821-4ff2-9cf6-c01cd0ab7c32"
      },
      "text": "fn_feed_health(5)\r\n| project status, active_branches, silent_branches, expected_branches, feed_minutes_silent, feed_last_event",
      "id": "b7c653c3-e14a-42fd-bfef-1c3a7cafd795",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "60479589-e821-4ff2-9cf6-c01cd0ab7c32"
      },
      "text": "fn_silent_branches(5)\r\n| extend last_sale_riyadh = datetime_utc_to_local(last_sale, 'Asia/Riyadh')\r\n| project pharmacy_id, region_name, minutes_silent, last_sale_riyadh, receipts",
      "id": "649d2bbb-2409-4de3-817a-a8803ab6ab50",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "60479589-e821-4ff2-9cf6-c01cd0ab7c32"
      },
      "text": "live_sales\r\n| where event_time > ago(30m)\r\n| summarize revenue_sar = round(sum(amount_sar), 0) by region_name\r\n| order by revenue_sar desc",
      "id": "b090b592-6c50-4687-89c2-25bdf62abaf0",
      "usedVariables": []
    }
  ],

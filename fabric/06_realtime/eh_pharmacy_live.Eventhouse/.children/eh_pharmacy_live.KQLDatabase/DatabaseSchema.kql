// KQL script
// Use management commands in this script to configure your database items, such as tables, functions, materialized views, and more.


.create-merge table live_sales (event_time:datetime, receipt_id:string, pharmacy_id:string, region_name:string, items:int, amount_sar:real, payment_type:string) 
.create-or-alter table live_sales ingestion json mapping 'live_sales_json'
```
[{"Properties":{"Path":"$.event_time"},"column":"event_time","datatype":"datetime"},{"Properties":{"Path":"$.receipt_id"},"column":"receipt_id","datatype":"string"},{"Properties":{"Path":"$.pharmacy_id"},"column":"pharmacy_id","datatype":"string"},{"Properties":{"Path":"$.region_name"},"column":"region_name","datatype":"string"},{"Properties":{"Path":"$.items"},"column":"items","datatype":"int"},{"Properties":{"Path":"$.amount_sar"},"column":"amount_sar","datatype":"real"},{"Properties":{"Path":"$.payment_type"},"column":"payment_type","datatype":"string"}]
```
.create-or-alter function with (folder = "live", docstring = "Branches with no sale for at least threshold_min minutes", skipvalidation = "true") fn_silent_branches(threshold_min:int=10) {
    live_sales
    | where event_time > ago(1d)
    | summarize last_sale = max(event_time), receipts = count() by pharmacy_id, region_name
    | extend minutes_silent = datetime_diff('minute', now(), last_sale)
    | where minutes_silent >= threshold_min
    | order by minutes_silent desc
}
.create-or-alter function with (folder = "live", docstring = "One row: is the sales feed alive, and how many branches are silent", skipvalidation = "true") fn_feed_health(threshold_min:int=10) {
    let expected_branches = toscalar(live_sales | where event_time > ago(1d) | summarize dcount(pharmacy_id));
    live_sales
    | where event_time > ago(1d)
    | summarize last_sale = max(event_time) by pharmacy_id
    | summarize feed_last_event = max(last_sale),
                silent_branches = countif(datetime_diff('minute', now(), last_sale) >= threshold_min),
                active_branches = countif(datetime_diff('minute', now(), last_sale) <  threshold_min)
    | extend expected_branches = expected_branches,
             feed_minutes_silent = datetime_diff('minute', now(), feed_last_event)
    | extend status = case(
        feed_minutes_silent >= threshold_min,             "FEED DOWN",
        silent_branches * 2 > expected_branches,         "FEED DEGRADED",
        silent_branches > 0,                             "BRANCH ISSUE",
                                                         "OK")
}
